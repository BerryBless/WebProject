{
  "$id": "features.schema.json", "type": "object", "additionalProperties": false,
  "properties": {
    "features": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/featureSummary" } },
    "excludedCandidates": { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": { "name": { "type": "string" }, "reason": { "type": "string" } }, "required": ["name", "reason"] } },
    "unknowns": { "$ref": "common.schema.json#/$defs/stringList" }
  },
  "required": ["features", "excludedCandidates", "unknowns"]
}

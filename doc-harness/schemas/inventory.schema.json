    "languages": { "$ref": "common.schema.json#/$defs/claimList" }, "frameworks": { "$ref": "common.schema.json#/$defs/claimList" }, "runtimes": { "$ref": "common.schema.json#/$defs/claimList" },
    "entryPoints": { "$ref": "common.schema.json#/$defs/claimList" },
    "directories": { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": { "path": { "type": "string" }, "role": { "type": "string" }, "status": { "$ref": "common.schema.json#/$defs/status" } }, "required": ["path", "role", "status"] } },
    "configs": { "$ref": "common.schema.json#/$defs/claimList" }, "environments": { "$ref": "common.schema.json#/$defs/claimList" }, "build": { "$ref": "common.schema.json#/$defs/claimList" },

    "queues": { "$ref": "common.schema.json#/$defs/claimList" }, "externalSystems": { "$ref": "common.schema.json#/$defs/claimList" }, "containers": { "$ref": "common.schema.json#/$defs/claimList" },
    "ci": { "$ref": "common.schema.json#/$defs/claimList" }, "tests": { "$ref": "common.schema.json#/$defs/claimList" }, "scripts": { "$ref": "common.schema.json#/$defs/claimList" },
    "migrations": { "$ref": "common.schema.json#/$defs/claimList" }, "staticResources": { "$ref": "common.schema.json#/$defs/claimList" }, "tooling": { "$ref": "common.schema.json#/$defs/claimList" },
    "unknowns": { "$ref": "common.schema.json#/$defs/stringList" }
  },
  "required": ["project", "languages", "frameworks", "runtimes", "entryPoints", "directories", "configs", "environments", "build", "dependencies", "databases", "caches", "queues", "externalSystems", "containers", "ci", "tests", "scripts", "migrations", "staticResources", "tooling", "unknowns"]

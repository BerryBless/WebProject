<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CompressionEnabled=false: 기본값(true)이면 publish 출력 wwwroot에 css/site.css.br·css/site.css.gz가 함께 생기고,
         정적 파일 미들웨어가 그 파일들도 그대로 서빙해 /css/site.css.gz가 200이 된다(실측). 내용은 공개 CSS와 같아 유출은 없지만
         공개 표면에 의도하지 않은 경로가 늘어난다. 이 앱의 유일한 정적 파일은 site.css 하나라 압축 산출물의 이득이 없으므로 끈다
         (실측: 이 속성을 넣으면 publish 출력 wwwroot가 css/site.css 하나가 되고, staticwebassets 엔드포인트 매니페스트에도 .gz·.br 항목이 없다). -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- BoundedHighlighting.cs의 internal 타입(TimeBoundedLanguageCompiler·DeadlineLanguageParser·공유 SharedParser)을
         테스트가 직접 구성해 기본 HtmlClassFormatter 출력과 바이트 단위로 비교할 수 있어야 한다(교체가 토큰화를 바꾸지 않았음을 증명).
         이 항목은 [assembly: InternalsVisibleTo] 특성을 자동 생성한다. -->
    <InternalsVisibleTo Include="PortfolioBlog.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="ColorCode.HTML" />
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" />
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>

</Project>

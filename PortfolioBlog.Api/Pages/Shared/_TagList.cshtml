@model IReadOnlyList<PublicTag>
@if (Model.Count > 0)
{
    <ul class="tag-list">
        @foreach (var tag in Model)
        {
            var href = PublicUrls.Tag(tag.NormalizedName);
            <li>
                @if (href is null)
                {
                    <span class="tag">@tag.Name</span>
                }
                else
                {
                    <a class="tag" href="@href">@tag.Name</a>
                }
            </li>
        }
    </ul>
}

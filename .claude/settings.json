{
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "permissions": {
    "deny": [
      "WebSearch",
      "WebFetch",
      "NotebookEdit"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/hooks/guard-write-scope.ps1 -Mode map",
            "shell": "powershell",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$env:CLAUDE_PROJECT_DIR\\scripts\\auto-commit.ps1\"",
            "shell": "powershell",
            "timeout": 120,
            "statusMessage": "변경사항 자동 커밋 중...",
            "asyncRewake": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "harness@harness-marketplace": true,
    "superpowers@claude-plugins-official": false,
    "superpowers@superpowers-marketplace": true
  }
}
